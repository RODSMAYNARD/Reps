{
  "expo": {
    "name": "Reps",
    "slug": "reps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rodrigomaynard.reps",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rodrigomaynard.reps",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": "development"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Reps uses your photo library so you can attach progress and workout photos.",
          "cameraPermission": "Reps does not use the camera; photos are picked from your library. This permission is never requested.",
          "microphonePermission": "Reps does not record audio. This permission is never requested."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Reps needs permission to save your share images to Photos.",
          "isAccessMediaLocationEnabled": false,
          "photosPermission": "Reps uses your photo library so you can attach progress and workout photos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0A84FF",
          "sounds": [
            "./assets/sounds/rest_default.wav",
            "./assets/sounds/rest_alarm.wav",
            "./assets/sounds/rest_futuristic.wav",
            "./assets/sounds/rest_ting.wav",
            "./assets/sounds/rest_boxing.wav",
            "./assets/sounds/rest_iron.wav",
            "./assets/sounds/rest_marimba.wav",
            "./assets/sounds/rest_liftoff.wav"
          ]
        }
      ],
      "expo-localization",
      "@sentry/react-native",
      [
        "expo-audio",
        {
          "microphonePermission": "Reps does not record audio. This permission is never requested.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "reps",
    "owner": "rodsappz4u",
    "extra": {
      "eas": {
        "projectId": "47b8c625-e5c0-42a9-aa1b-52bc7fe35a6e"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/47b8c625-e5c0-42a9-aa1b-52bc7fe35a6e"
    }
  }
}
